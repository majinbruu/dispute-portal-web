# Security headers for everything this server answers itself.
#
# nginx only inherits add_header from the enclosing level when a location defines none of its
# own, so every location that sets Cache-Control includes this file to keep the full set.
# Rendered to /etc/nginx/conf.d/security-headers.inc (not *.conf, so it is not loaded on its own).
#
# The bundle has no inline scripts or styles, so neither needs 'unsafe-inline'. The identity
# provider origin is allowed for token requests (connect-src) and silent renewal (frame-src).
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${OIDC_ORIGIN}; frame-src ${OIDC_ORIGIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=()" always;
add_header Cross-Origin-Opener-Policy "same-origin" always;
