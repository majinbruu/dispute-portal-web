# Rendered by the nginx image's envsubst entrypoint. Only ${VARIABLES} that exist in the
# environment are substituted, so nginx's own $variables are left alone.
#
#   OIDC_AUTHORITY  issuer URL, e.g. http://localhost:8080/realms/acme-bank
#   OIDC_ORIGIN     origin of the issuer for the CSP, e.g. http://localhost:8080
#   OIDC_CLIENT_ID  public client ID, e.g. dispute-portal-web
#   API_UPSTREAM    API base URL without a trailing slash, e.g. http://api:8080

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    server_tokens off;
    absolute_redirect off;
    client_max_body_size 64k;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    include /etc/nginx/conf.d/security-headers.inc;

    # Liveness probe for the container itself.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # Runtime configuration for the SPA, built from the environment so one image runs anywhere.
    location = /config.js {
        default_type application/javascript;
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        return 200 'window.__APP_CONFIG__ = { oidcAuthority: "${OIDC_AUTHORITY}", oidcClientId: "${OIDC_CLIENT_ID}", apiBaseUrl: "" };';
    }

    # Only /api/ reaches the API. Its operational endpoints (/health, /metrics) live outside
    # /api and are answered here with 404 so they can never be reached through the web tier.
    location ~ ^/(health|metrics)(/|$) {
        include /etc/nginx/conf.d/security-headers.inc;
        return 404;
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        # API responses are per-customer and must never be stored by a shared cache.
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Vite fingerprints everything under /assets/, so it can be cached forever. No `always`:
    # a 404 for an asset from another release must not be cached for a year.
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # The HTML shell is always revalidated so a new release is picked up immediately.
    location = /index.html {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
    }

    # Client-side routes fall back to the shell (history API routing).
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
