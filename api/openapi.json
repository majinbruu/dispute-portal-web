      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "Lists the customer's inbox, newest first.",
        "operationId": "ListNotifications",
        "parameters": [
          {
            "name": "unreadOnly",
            "in": "query",
            "schema": {
              "type": "boolean"
