                  "items": {
                    "$ref": "#/components/schemas/DisputeReasonDto"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DisputeReasonDto"
                  }
                }
              }
            }
          }
        }
      }
    },
