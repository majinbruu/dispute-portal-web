{
  "openapi": "3.1.1",
  "info": {
    "title": "ACME Bank Dispute Portal API",
    "description": "Debit orders, mandates, disputes and notifications for the signed-in customer. All endpoints under /api require a Keycloak access token with the 'customer' role. Errors are RFC 9457 problem documents with a stable 'code' and a 'traceId'.",
    "version": "v1"
  },
  "paths": {
    "/api/v1/debit-orders": {
      "get": {
        "tags": [
          "Debit orders"
        ],
        "summary": "Lists the customer's debit orders, newest first, with whether each can be disputed.",
        "operationId": "ListDebitOrders",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/DebitOrderStatus"
            }
          },
          {
            "name": "mandateType",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/MandateType"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResultOfDebitOrderDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResultOfDebitOrderDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResultOfDebitOrderDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/debit-orders/{id}": {
      "get": {
        "tags": [
          "Debit orders"
        ],
        "summary": "Returns one debit order with its dispute eligibility.",
        "operationId": "GetDebitOrder",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/DebitOrderDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DebitOrderDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/DebitOrderDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/mandates": {
      "get": {
        "tags": [
