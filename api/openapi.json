                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResultOfNotificationDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResultOfNotificationDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
