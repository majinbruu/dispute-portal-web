  "components": {
    "schemas": {
      "CollectionFrequency": {
        "enum": [
          "Weekly",
          "Fortnightly",
          "Monthly",
          "Quarterly",
          "Annually"
        ]
      },
      "DebitOrderDto": {
        "required": [
          "id",
          "transactionId",
          "endToEndId",
          "creditorName",
          "creditorShortName",
          "statementText",
          "amount",
          "currency",
          "actionDate",
          "sequenceType",
          "status",
          "statusReasonCode",
          "statusReason",
          "debtorAccountMasked",
          "mandateId",
          "mandateType",
          "mandateReference",
          "eligibility",
          "dispute"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "transactionId": {
            "type": "string"
          },
          "endToEndId": {
            "type": "string"
          },
          "creditorName": {
            "type": "string"
          },
          "creditorShortName": {
            "type": "string"
          },
          "statementText": {
            "type": "string"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "actionDate": {
            "type": "string",
            "format": "date"
          },
          "sequenceType": {
            "$ref": "#/components/schemas/SequenceType"
          },
          "status": {
            "$ref": "#/components/schemas/DebitOrderStatus"
          },
          "statusReasonCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "statusReason": {
            "type": [
              "null",
              "string"
            ]
          },
          "debtorAccountMasked": {
            "type": "string"
          },
          "mandateId": {
            "type": "string",
            "format": "uuid"
          },
          "mandateType": {
            "$ref": "#/components/schemas/MandateType"
          },
          "mandateReference": {
            "type": "string"
          },
          "eligibility": {
            "$ref": "#/components/schemas/DisputeEligibilityDto"
          },
          "dispute": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/DisputeLinkDto"
              }
            ]
          }
        }
      },
      "DebitOrderStatus": {
        "enum": [
          "Accepted",
          "Rejected"
        ]
      },
      "DisputeDetailDto": {
        "required": [
          "id",
          "reference",
          "debitOrderId",
          "originalTransactionId",
          "creditorName",
          "mandateType",
          "mandateReference",
          "amount",
          "currency",
          "actionDate",
          "reasonCode",
          "reasonDescription",
          "status",
          "state",
          "submittedAt",
          "completedAt",
          "outcomeNote",
          "events"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reference": {
            "type": "string"
          },
          "debitOrderId": {
            "type": "string",
            "format": "uuid"
          },
          "originalTransactionId": {
            "type": "string"
          },
          "creditorName": {
            "type": "string"
          },
          "mandateType": {
            "type": "string"
          },
          "mandateReference": {
            "type": "string"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "actionDate": {
            "type": "string",
            "format": "date"
          },
          "reasonCode": {
            "type": "string"
          },
          "reasonDescription": {
            "type": "string"
